@model ChangePasswordModel
@{
    ViewData["Title"] = "Change password";
}
<div class="mx-auto max-w-md">
    <h1 class="mb-6 text-xl font-semibold text-slate-900">Change password</h1>
    <div asp-validation-summary="ModelOnly" class="alert alert-error [&_ul]:list-none"></div>
    <form asp-action="ChangePassword" method="post" class="card card-body space-y-4">
        <div>
            <label asp-for="CurrentPassword" class="label">Current password</label>
            <input asp-for="CurrentPassword" class="input" autocomplete="current-password" required />
        </div>
        <div>
            <label asp-for="NewPassword" class="label">New password</label>
            <input asp-for="NewPassword" class="input" autocomplete="new-password" minlength="12" required />
            <p class="hint">At least 12 characters.</p>
        </div>
        <div>
            <label asp-for="ConfirmPassword" class="label">Repeat new password</label>
            <input asp-for="ConfirmPassword" class="input" autocomplete="new-password" minlength="12" required />
        </div>
        <div class="flex gap-2">
            <button type="submit" class="btn btn-primary">Change password</button>
            <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>
