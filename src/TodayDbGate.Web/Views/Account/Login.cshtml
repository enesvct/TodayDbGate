@model LoginModel
@{
    ViewData["Title"] = "Sign in";
    Layout = "_AuthLayout";
}
<div class="card card-body">
    <h1 class="mb-4 text-base font-semibold text-slate-900">Sign in to the dashboard</h1>

    <div asp-validation-summary="ModelOnly" class="alert alert-error [&_ul]:list-none"></div>

    <form asp-action="Login" method="post" class="space-y-4">
        <input type="hidden" asp-for="ReturnUrl" />
        <div>
            <label asp-for="Username" class="label">Username</label>
            <input asp-for="Username" class="input" autocomplete="username" required />
        </div>
        <div>
            <label asp-for="Password" class="label">Password</label>
            <input asp-for="Password" class="input" autocomplete="current-password" required autofocus />
        </div>
        <button type="submit" class="btn btn-primary w-full">Sign in</button>
    </form>
</div>
<p class="mt-4 text-center text-xs text-slate-500">
    First start? The initial password for <span class="font-mono">admin</span> is written once to the server log.
</p>
