{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Storage": {
    "DataDirectory": "App_Data"
  },
  "Gateway": {
    "MaxRows": 0,
    "CommandTimeoutSeconds": 30,
    "MaxSqlLength": 100000
  },
  "Audit": {
    "Enabled": true,
    "StoreOutput": true,
    "RetentionDays": 30,
    "MaxStoredRows": 50,
    "MaxStoredOutputKb": 64,
    "MaxInputChars": 20000,
    "MaxDatabaseMb": 1024
  }
}
